# GEMINI_API_KEY: Required for Gemini AI API calls.. 
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ADMIN_PASSWORD: Password for the built-in admin account. Admin login is disabled while this is the placeholder.
ADMIN_PASSWORD=MY_ADMIN_PASSWORD

# Firebase (live store sync): project "AmERAiStore", Android app com.aistudio.aicommerce.kpqzjx.
# These identify the project and ship inside every APK anyway; firestore.rules protects the data.
# Set them to values starting with MY_FIREBASE_ in .env to turn sync off. See docs/firebase-setup.md.
FIREBASE_API_KEY=AIzaSyDn3zX2nQtnm-rYVo_CSlAJM7hIiXxGZww
FIREBASE_APP_ID=1:350618456564:android:cc3fc56b217e2fa53a69a1
FIREBASE_PROJECT_ID=ameraistore-1c81d
