# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ADMIN_PASSWORD: Password for the built-in admin account. Admin login is disabled while this is the placeholder.
ADMIN_PASSWORD=MY_ADMIN_PASSWORD

# Firebase (live store sync). From Firebase Console > Project settings > Your apps > Android app.
# Sync to Firestore stays off while these are placeholders. See docs/firebase-setup.md.
FIREBASE_API_KEY=MY_FIREBASE_API_KEY
FIREBASE_APP_ID=MY_FIREBASE_APP_ID
FIREBASE_PROJECT_ID=MY_FIREBASE_PROJECT_ID
