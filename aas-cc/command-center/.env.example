# Configure production values through Sites Settings, not in browser code.
# Hosted service callers need this application key AND Sites private access.
AAS_API_TOKEN=
# Dedicated external execution identity; never share the Android app key with a runner.
# Missing token disables runner receipts; it does not activate automatic code editing.
AAS_RUNNER_TOKEN=
# Encryption key for provider credentials saved by the owner (64 hex digits).
AAS_SECRET_ENCRYPTION_KEY=
# JSON array of explicitly allowed external server origins (no paths).
AAS_ALLOWED_SERVER_ORIGINS=[]
# Native owner application access, configured by the Site owner.
AAS_PRIVATE_SITE_BEARER=
AAS_PUBLIC_ORIGIN=
# Optional actual Gemini service. Missing values return explicit errors.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ALLOWED_MODELS=[]
# Add only the named token required by a registered server.
# AAS_STORE_TOKEN=
