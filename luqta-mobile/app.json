{
  "expo": {
    "name": "لُقطة",
    "slug": "luqta",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/luqta-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luqta.store",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EB6A3E",
        "foregroundImage": "./assets/luqta-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luqta.store",
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/luqta-favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withLocalNetwork",
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "اسمح للُقطة باستخدام موقعك أثناء مشاركة موقع التوصيل أو تحديد عنوان الطلب."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "اسمح للُقطة باستخدام الكاميرا لمسح الباركود ولرؤية المنتج في غرفتك.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح للُقطة باختيار صورة للبحث بالصورة أو لإرفاقها بالمرتجع أو بمحادثة الدعم أو لوضعها على شاشة لُقطي.",
          "cameraPermission": "اسمح للُقطة بالتقاط صورة للبحث أو للمرتجع أو لشاشة لُقطي.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "luqta",
    "description": "متجر عربي مع مساعد تسوق ذكي"
  }
}
