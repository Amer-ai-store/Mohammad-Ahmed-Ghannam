{
  "expo": {
    "name": "لُقطة",
    "slug": "luqta",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/luqta-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luqta.store",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2FE",
        "foregroundImage": "./assets/luqta-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luqta.store",
      "versionCode": 4,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/luqta-favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withLocalNetwork",
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "اسمح للُقطة باستخدام موقعك أثناء مشاركة موقع التوصيل أو تحديد عنوان الطلب."
        }
      ]
    ],
    "scheme": "luqta",
    "description": "Amer AI Store | لُقطة — متجر عربي مع مساعد تسوق وشخصية ثلاثية الأبعاد"
  }
}
